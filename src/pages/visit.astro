---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Strap from '@/components/Strap.astro';
import Arrow from '@/components/Arrow.astro';
import { site } from '@/data/site';

const facts = [
  { k: 'Open daily', v: 'From 09:00' },
  { k: 'Weekend sessions', v: 'Cadenza 10:00 – 16:00' },
  { k: 'Night session', v: 'OPUS until 02:00' },
  { k: 'Pets', v: 'Pet friendly' },
  { k: 'The beach', v: 'Across the road' },
];
---

<Base
  title="Visit — Hours, directions & contact | Crush Playa de San Juan"
  description={`Crush, ${site.address.street}, ${site.address.postal} ${site.address.area}, ${site.address.city}. Open daily from 09:00. Directions, hours, contact and private events.`}
  theme="day"
  page="visit"
>
  <header class="wrap page-hero">
    <p class="label page-hero__label"><Strap /></p>
    <div class="page-hero__grid">
      <h1 class="display-xl page-hero__title" data-reveal="lines">Meet me at <span class="em">Crush.</span></h1>
      <div class="hero-side">
        <address class="lede" data-reveal="fade">
          {site.address.street}<br />
          {site.address.postal} {site.address.area}<br />
          {site.address.city}, {site.address.country}
        </address>
        <div class="chip" data-now data-reveal="fade" style="--reveal-delay: 80ms">
          <span class="chip__dot" aria-hidden="true"></span>
          <span class="chip__swap"><span class="chip__line" data-now-text>Open daily from 09:00</span></span>
        </div>
        <div class="hero-side__actions" data-reveal="fade" style="--reveal-delay: 140ms">
          <a href={site.maps} target="_blank" rel="noopener" class="btn">Get directions <Arrow dir="up-right" /></a>
          <a href={site.phoneHref} class="btn btn--ghost">{site.phone}</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Hours + map -->
  <section class="wrap section section--flush-top">
    <div class="grid where">
      <div class="where__info">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">01</span>
          <span class="label">Hours · Alicante time</span>
          <span class="label label--display">Every day</span>
        </div>
        <ul class="rule-list where__hours" data-stagger>
          {
            site.hours.map((h) => (
              <li>
                <span class="row__name">{h.days}</span>
                <span class="row__price">
                  {h.open} – {h.close}
                </span>
              </li>
            ))
          }
          <li>
            <span class="row__name">Events</span>
            <span class="row__price muted">Extended</span>
            <span class="row__desc">{site.hoursNote} See <a class="link-line" href="/sound#agenda">the agenda</a>.</span>
          </li>
        </ul>

        <div class="chapter-head where__head2" data-reveal="fade">
          <span class="num">02</span>
          <span class="label">Good to know</span>
          <span></span>
        </div>
        <ul class="rule-list" data-stagger>
          {
            facts.map((f) => (
              <li>
                <span class="row__name">{f.k}</span>
                <span class="row__price where__fact">{f.v}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="where__map">
        <div class="media where__embed" data-reveal="fade">
          <iframe
            src={site.mapEmbed}
            title="Map: Crush, Avenida de Niza 12, Playa de San Juan, Alicante"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <p class="small muted">Metro/TRAM: Playa de San Juan stops on lines 3 and 4 are a short walk. Parking along the avenue.</p>
      </div>
    </div>
  </section>

  <!-- Contact & events -->
  <section class="section contact" id="events">
    <div class="wrap grid contact__grid">
      <div class="contact__copy">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">03</span>
          <span class="label">Groups, events, anything</span>
          <span class="label label--display">Say hi</span>
        </div>
        <h2 class="display contact__title" data-reveal="lines">Your event, <span class="em">our clock.</span></h2>
        <p class="body" data-reveal="fade">
          Networking brunch at ten, a launch at sunset, a private session until two. Tell us the shape of it
          and we'll tell you how it fits.
        </p>
        <ul class="contact__list" data-stagger>
          <li><span class="label muted">Email</span><a class="link-line" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span class="label muted">Phone</span><a class="link-line" href={site.phoneHref}>{site.phone}</a></li>
          <li><span class="label muted">Instagram</span><a class="link-line" href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></li>
          <li><span class="label muted">Facebook</span><a class="link-line" href={site.facebook} target="_blank" rel="noopener">Crush Playa de San Juan</a></li>
        </ul>
      </div>

      <form class="form" data-contact-form data-endpoint="" novalidate data-reveal="fade">
        <p class="label muted form__title">Write to us</p>
        <div class="form__grid">
          <label class="field">
            <span class="field__label">Name</span>
            <input type="text" name="name" autocomplete="name" placeholder="Optional" />
          </label>
          <label class="field">
            <span class="field__label">Phone</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="Optional" />
          </label>
          <label class="field field--full">
            <span class="field__label">Email <i aria-hidden="true">*</i></span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </label>
          <label class="field field--full">
            <span class="field__label">What are you planning <i aria-hidden="true">*</i></span>
            <textarea name="message" rows="4" required maxlength="1000" placeholder="Date, number of people, the shape of it."></textarea>
          </label>
        </div>
        <div class="form__foot">
          <button type="submit" class="btn">Send message <Arrow /></button>
          <p class="small muted" data-form-status aria-live="polite">We reply from {site.email}.</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .hero-side {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero-side__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .where {
    align-items: start;
  }
  .where__info {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--space-5);
  }
  .where__head2 {
    margin-top: var(--space-6);
  }
  .where__fact {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-body);
    color: var(--ink-2);
  }
  .where__map {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--space-4);
  }
  .where__embed {
    /* Tall enough to read the street, not so tall it swallows the column */
    height: clamp(420px, 62vh, 720px);
  }
  .where__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.2) contrast(1.05);
  }
  @media (max-width: 900px) {
    .where__info,
    .where__map {
      grid-column: 1 / -1;
    }
  }

  .contact__grid {
    align-items: start;
  }
  .contact__copy {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--space-5);
  }
  .contact__title {
    margin-top: var(--space-3);
  }
  .contact__list {
    display: grid;
    gap: 0.9rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }
  .contact__list li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: 1rem;
    font-weight: 600;
  }
  /* Editorial form: no box, one rule per field, big quiet type */
  .form {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }
  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-5);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field__label {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color var(--dur-fast);
  }
  .field__label i {
    font-style: normal;
    color: var(--accent-ink);
  }
  .field:focus-within .field__label {
    color: var(--ink);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.4;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-3);
    opacity: 0.8;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 0;
    border-bottom-color: var(--ink);
    box-shadow: 0 1px 0 0 var(--ink);
  }
  .field textarea {
    resize: vertical;
    min-height: 6.5rem;
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }
  @media (max-width: 900px) {
    .contact__copy,
    .form {
      grid-column: 1 / -1;
    }
    .form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
