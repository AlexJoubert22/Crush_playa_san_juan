---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Strap from '@/components/Strap.astro';
import Arrow from '@/components/Arrow.astro';
import DishDialog from '@/components/DishDialog.astro';
import menu from '@/data/menu.json';

const photos = import.meta.glob<ImageMetadata>('/src/assets/menu/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const photoFor = (name?: string | null) => (name ? photos[`/src/assets/menu/${name}`] : undefined);

const thumbs = import.meta.glob<ImageMetadata>('/src/assets/menu/thumbs/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const thumbFor = (name?: string | null) => (name ? thumbs[`/src/assets/menu/thumbs/${name}`] : undefined);

type Item = (typeof menu.items)[number];
const tabs = [
  { id: 'drinks', label: 'Drinks' },
  { id: 'food', label: 'Food' },
] as const;

const catName = (id: string, fallback: string) =>
  ({ bowls: 'Açaí', bowles: 'Bowls', nonAlcoholic: 'Soft drinks', frappes: 'Frappés' })[id] ?? fallback;

const catIntro: Record<string, string> = {
  coffee: 'Specialty beans, hot or over ice. Seven flavoured iced lattes.',
  matcha: 'Premium Japanese matcha, hot or iced, six fruit pairings.',
  frappes: 'Ice-cold blends of specialty coffee and milk.',
  smoothies: 'Fresh fruit, blended. Add protein or a shot.',
  shakes: 'Ice-cream milkshakes, some with a coffee twist.',
  teas: 'Black, green, chai and infusions.',
  nonAlcoholic: 'Juices, sodas, premium mixers and alcohol-free options.',
  spritz: 'Prosecco, soda and something bitter or floral.',
  cocktails: 'Tropical and classic, frozen or on the rocks.',
  beer: 'Estrella Galicia on tap and in bottles, Corona, gluten-free and 0.0.',
  wine: 'House wines by the glass and a few picks.',
  spirits: 'Gin, rum, tequila, whisky and vodka. There is a 0.0 gin.',
  specials: 'Combos, buckets and happy hour.',
  brunch: 'Gourmet toast, eggs on brioche and French toast.',
  bowls: 'Açaí with your choice of fruit, toppings and sauces.',
  bowles: 'Yoghurt bowls with compote and fresh fruit.',
  sandwiches: 'Cuban-style artisan bread, pressed.',
  'smash-burgers': 'Double smashed patties on soft potato rolls.',
  'loaded-fries': 'Homemade fries, loaded.',
  salads: "Big salads with goat's cheese and roasted vegetables.",
  desserts: 'New York cheesecake, Florida key lime pie, cookies, chocolate cake.',
};

const tagFor = (i: Item) => {
  const n = i.name.en;
  if (n === 'Summer Crush') return 'House special';
  if (n === 'El Crush' || n === 'Crush Club') return 'Signature';
  if (n === 'The Classic') return 'The Cuban';
  if (n === 'Espresso & Tonic' || n === 'Iced Yuzu Matcha' || n === 'Paloma Premium') return 'Try this';
  return null;
};

const cats = menu.categories.map((c) => ({
  ...c,
  label: catName(c.id, c.name.en),
  intro: catIntro[c.id],
  items: menu.items.filter((i) => i.category === c.id),
}));

/** Photos for a category: three at most, and never the same shot twice. */
const photoSet = (items: Item[]) => {
  const seen = new Set<string>();
  return items
    .filter((i) => {
      if (!i.photo || seen.has(i.photo)) return false;
      seen.add(i.photo);
      return true;
    })
    .slice(0, 3);
};

/**
 * A category with a single photo gets a written panel beside it instead of a
 * hole. House notes, in the room's own voice.
 */
const SOLO_NOTES: Record<string, { note: string; quote: string; by: string }> = {
  Affogato: {
    note: 'Two things that shouldn’t work together at 11am, and do. A double shot pulled short, poured at the table over vanilla ice cream so it collapses in front of you. Drink it before it becomes a milkshake — that’s the whole point.',
    quote: 'Coffee is a dessert that learned to wake you up.',
    by: 'The counter, most mornings',
  },
  'Sweet Greek': {
    note: 'Dense Greek yoghurt, red berry compote made in-house, seasonal fruit and enough granola to give it a spine. The bowl people order when the açaí feels like too much sugar before noon.',
    quote: 'Breakfast should feel like a decision, not a default.',
    by: 'House note',
  },
  'Açaí Bowl 300g': {
    note: 'Açaí blended thick enough to hold a spoon upright, two fruits of your choosing, granola for the crunch and whatever sauce you point at. Built to order in a coconut bowl, because it holds the cold longer.',
    quote: 'The only bowl on the coast that survives the walk to the beach.',
    by: 'Regulars, in July',
  },
  'Fever-Tree Ginger Beer': {
    note: 'Served the way it should be: bottle on the side, tall glass, hard ice, no fruit fighting it. Sharp enough to work as a drink on its own, which is why half of them never make it into a Moscow Mule.',
    quote: 'Alcohol-free should never mean afterthought.',
    by: 'Behind the bar',
  },
  'Petroni Spritz': {
    note: 'Petroni, prosecco and soda in the right order, poured over a glass filled properly. Bitter orange, not sweet, and the one the staff drink when the shift ends and the terrace is still full.',
    quote: 'Six o’clock has a flavour, and this is it.',
    by: 'The terrace, every evening',
  },
};

const groups = (items: Item[]) => {
  const subs = Array.from(new Set(items.map((i) => i.sub).filter(Boolean))) as string[];
  if (!subs.length) return [{ sub: null, items }];
  const order = ['Hot', 'Cold'];
  subs.sort((a, b) => order.indexOf(a) - order.indexOf(b));
  return subs.map((s) => ({ sub: s, items: items.filter((i) => i.sub === s) }));
};

const film = [
  'iberia.jpeg',
  'cn.jpeg',
  'gin-bramble-2.jpg',
  'benedictinos.jpeg',
  'oklahoma-2.png',
  'luna-rossa-2.jpeg',
  'santiago.png',
  'sweet-greek.jpeg',
  'petroni-spritz.jpg',
  'spicy-marg-1.png',
].map((f) => photoFor(f)!);

/**
 * What a dish is, in words the kitchen would recognise. Everything here comes
 * out of the item's own name and description — nothing is invented.
 */
const tagsFor = (i: Item, catLabel: string): string[] => {
  const out = [catLabel];
  if (i.sub) out.push(i.sub.replace(/-/g, ' '));
  const d = `${i.name.en} ${i.description.en}`.toLowerCase();
  const add = (t: string) => !out.includes(t) && out.push(t);
  if (d.includes('specialty coffee')) add('Specialty coffee');
  if (d.includes('matcha')) add('Japanese matcha');
  if (d.includes('0.0') || d.includes('non-alcoholic') || d.includes('virgin')) add('Alcohol-free');
  if (d.includes('vegetarian') || d.includes('veggie')) add('Vegetarian');
  if (d.includes('gluten free')) add('Gluten free');
  if (d.includes('frozen')) add('Frozen');
  if (d.includes('agave')) add('100% agave');
  if (d.includes('cuban-style artisan bread')) add('Cuban bread');
  if (d.includes('brioche')) add('On brioche');
  if (d.includes('prosecco')) add('Prosecco');
  if (d.includes('protein')) add('Protein');
  return out.slice(0, 5);
};

/** A photo's own proportions, kept inside a sane band. */
const ratioOf = (img: ImageMetadata, min = 0.7, max = 1.9) =>
  Math.min(max, Math.max(min, img.width / img.height)).toFixed(3);

/**
 * Stills for the dialog. Two grades on purpose: the venue's own 160px menu
 * thumbnails would fall apart blown up to fill a panel, so those are served at
 * their native size as a framed inset instead of being stretched.
 */
const dialogImages = new Map<string, string>();
const dialogThumbs = new Map<string, string>();
for (const i of menu.items) {
  if (i.photo) {
    const src = photoFor(i.photo);
    if (src) dialogImages.set(i.id, (await getImage({ src, width: 900, format: 'webp' })).src);
  } else if ((i as { thumb?: string }).thumb) {
    const src = thumbFor((i as { thumb?: string }).thumb);
    if (src) dialogThumbs.set(i.id, (await getImage({ src, width: 320, format: 'webp' })).src);
  }
}

const eur = (n: number | null) => (n == null ? '' : `€${Number.isInteger(n) ? n : n.toFixed(2)}`);
const updated = new Date(menu.updatedAt).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const total = menu.items.length;
---

<Base
  title="Menu — Specialty coffee, brunch, Cuban sandwiches & cocktails | Crush Alicante"
  description={`The full Crush menu: ${total} items across coffee, matcha, smoothies, brunch, açaí bowls, Cuban sandwiches, smash burgers, spritz and cocktails. Playa de San Juan, Alicante.`}
  theme="day"
  page="menu"
>
  <div class="menu-page" data-menu-page data-tab="drinks">
    <header class="wrap page-hero">
      <p class="label page-hero__label"><Strap /></p>
      <div class="page-hero__grid">
        <h1 class="display-xl page-hero__title" data-reveal="lines">Taste &amp; <span class="em">sip.</span></h1>
        <div>
          <p class="lede" data-reveal="fade">
            From açaí bowls to Cuban sandwiches, specialty coffee and tropical cocktails. Order whatever you
            want, whenever you want, from 09:00.
          </p>
          <p class="small muted menu-page__note" data-reveal="fade" style="--reveal-delay: 100ms">
            {total} items · prices in euros · updated {updated}
          </p>
        </div>
      </div>

    </header>

    <!-- Film strip: the counter, passing by -->
    <div class="film" aria-hidden="true" data-reveal="fade">
      <div class="film__track">
        {
          [0, 1].map(() =>
            film.map((img) => (
              <figure class="film__item media">
                <Image src={img} alt="" widths={[520]} sizes="520px" />
              </figure>
            )),
          )
        }
      </div>
    </div>

    <!-- One bar for the whole page, so the switch thumb can actually travel -->
    <nav class="catnav" aria-label="Menu navigation">
      <div class="catnav__inner wrap">
        <div class="catnav__switch" role="tablist" aria-label="Menu sections">
          <span class="catnav__thumb" aria-hidden="true"></span>
          {
            tabs.map((s) => (
              <button
                type="button"
                role="tab"
                class="catnav__tab"
                id={`tab-${s.id}`}
                data-tab={s.id}
                aria-controls={`panel-${s.id}`}
                aria-selected={s.id === 'drinks' ? 'true' : 'false'}
              >
                {s.label}
              </button>
            ))
          }
        </div>
        <span class="catnav__divider" aria-hidden="true"></span>
        {
          tabs.map((t) => (
            <div class="catnav__scroll" data-scroll-for={t.id}>
              {cats
                .filter((c) => c.tab === t.id)
                .map((c) => (
                  <a href={`#${c.id}`} class="catnav__link" data-cat-link>
                    {c.label}
                    <span class="catnav__n num">{c.items.length}</span>
                  </a>
                ))}
            </div>
          ))
        }
      </div>
      <span class="catnav__progress" data-menu-progress aria-hidden="true"></span>
    </nav>

    {
      tabs.map((t) => {
        const tabCats = cats.filter((c) => c.tab === t.id);
        return (
          <div class="panel" data-tab-panel={t.id} id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`}>
            <div class="wrap">
              {tabCats.map((c, ci) => {
                const withPhoto = photoSet(c.items);
                return (
                  <section class="cat" id={c.id} data-cat>
                    <div class="chapter-head">
                      <span class="num">{String(ci + 1).padStart(2, '0')}</span>
                      <h2 class="h2 cat__title">{c.label}</h2>
                      <span class="label muted">{c.items.length} items</span>
                    </div>
                    {c.intro && <p class="cat__intro lede">{c.intro}</p>}

                    {/* One photo: pair it with the item itself, so nothing floats alone */}
                    {withPhoto.length === 1 && (
                      <div class="cat__solo" data-reveal="fade">
                        <figure
                          class="media cat__photo"
                          style={`--ar: ${ratioOf(photoFor(withPhoto[0].photo)!, 0.8, 1.5)}`}
                        >
                          <Image
                            src={photoFor(withPhoto[0].photo)!}
                            alt={withPhoto[0].name.en}
                            widths={[420, 720, 1096]}
                            sizes="(max-width: 900px) 100vw, 45vw"
                          />
                        </figure>
                        <div class="cat__solo-copy">
                          <p class="label muted">Worth ordering</p>
                          <h3 class="cat__solo-name">
                            {withPhoto[0].name.en}
                            <span class="num">{eur(withPhoto[0].price)}</span>
                          </h3>
                          {withPhoto[0].description.en && (
                            <p class="small muted cat__solo-sub">{withPhoto[0].description.en}</p>
                          )}
                          {SOLO_NOTES[withPhoto[0].name.en] && (
                            <>
                              <p class="body cat__solo-note">{SOLO_NOTES[withPhoto[0].name.en].note}</p>
                              <blockquote class="cat__solo-quote">
                                <p>{SOLO_NOTES[withPhoto[0].name.en].quote}</p>
                                <footer class="label muted">{SOLO_NOTES[withPhoto[0].name.en].by}</footer>
                              </blockquote>
                            </>
                          )}
                        </div>
                      </div>
                    )}

                    {withPhoto.length > 1 && (
                      <div class={`cat__photos cat__photos--${withPhoto.length}`}>
                        {withPhoto.map((i, pi) => (
                          <figure
                            class="media cat__photo"
                            data-reveal="clip"
                            style={`--reveal-delay: ${pi * 90}ms; --ar: ${ratioOf(photoFor(i.photo)!)}`}
                          >
                            <Image
                              src={photoFor(i.photo)!}
                              alt={i.name.en}
                              widths={[420, 720, 1096]}
                              sizes="(max-width: 900px) 100vw, 33vw"
                              class="reveal-scale"
                            />
                            <figcaption class="cat__caption">
                              <span>{i.name.en}</span>
                              <span class="num">{eur(i.price)}</span>
                            </figcaption>
                          </figure>
                        ))}
                      </div>
                    )}

                    {groups(c.items).map((g) => (
                      <div class="cat__group">
                        {g.sub && <p class="label muted cat__sub">{g.sub.replace(/-/g, ' ')}</p>}
                        <ul class="rule-list cat__list">
                          {g.items.map((i) => {
                            const tag = tagFor(i);
                            const note = SOLO_NOTES[i.name.en];
                            return (
                              <li>
                                <button
                                  type="button"
                                  class="row"
                                  data-dish
                                  data-name={i.name.en}
                                  data-price={eur(i.price)}
                                  data-desc={i.description.en || ''}
                                  data-kicker={[c.label, i.sub?.replace(/-/g, ' ')].filter(Boolean).join(' · ')}
                                  data-tags={tagsFor(i, c.label).join('|')}
                                  data-img={dialogImages.get(i.id) ?? ''}
                                  data-thumb={dialogThumbs.get(i.id) ?? ''}
                                  data-note={note?.note ?? ''}
                                  data-quote={note?.quote ?? ''}
                                  data-by={note?.by ?? ''}
                                >
                                  <span class="row__name">
                                    {i.name.en}
                                    {tag && <span class="tag">{tag}</span>}
                                  </span>
                                  <span class="row__price">{eur(i.price)}</span>
                                  {i.description.en && <span class="row__desc">{i.description.en}</span>}
                                  <span class="row__more" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                      <path d="M4 12h15" />
                                      <path d="M13 6l6 6-6 6" />
                                    </svg>
                                  </span>
                                </button>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    ))}
                  </section>
                );
              })}
            </div>
          </div>
        );
      })
    }

    <section class="wrap section--tight menu-page__foot">
      <hr class="rule rule--strong" />
      <div class="menu-page__foot-grid">
        <p class="small muted">
          Allergens and dietary options: ask the team. Gluten-free beer, alcohol-free spirits and alternative milks
          are on the list. Kitchen and bar hours follow the venue's opening hours.
        </p>
        <div class="menu-page__cta">
          <a href="/visit" class="btn">Find us <Arrow /></a>
          <a href="/sound#agenda" class="btn btn--ghost">What's on</a>
        </div>
      </div>
    </section>
  </div>

  <DishDialog />
</Base>

<style>
  .menu-page__note {
    margin-top: var(--space-4);
  }
  .film {
    overflow: hidden;
    padding-block: var(--space-2) 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .film__track {
    display: flex;
    gap: 8px;
    width: max-content;
    animation: film 90s linear infinite;
  }
  .film:hover .film__track {
    animation-play-state: paused;
  }
  .film__item {
    flex: 0 0 auto;
    width: clamp(200px, 22vw, 340px);
    aspect-ratio: 16 / 11;
  }
  @keyframes film {
    to {
      transform: translateX(calc(-50% - 4px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .film {
      overflow-x: auto;
    }
    .film__track {
      animation: none;
    }
  }
  .panel {
    display: none;
  }
  [data-tab='drinks'] .panel[data-tab-panel='drinks'],
  [data-tab='food'] .panel[data-tab-panel='food'] {
    display: block;
  }

  .catnav {
    position: sticky;
    top: 76px;
    z-index: 5;
    isolation: isolate;
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
    transition: background-color var(--dur-theme) var(--ease-inout);
  }
  .catnav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  /* Two equal halves with a thumb that slides between them */
  .catnav__switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    flex-shrink: 0;
    width: 10.5rem;
    padding: 3px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    isolation: isolate;
  }
  .catnav__thumb {
    position: absolute;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: var(--radius-pill);
    background: var(--ink);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.28, 1);
  }
  [data-tab='food'] .catnav__thumb {
    transform: translateX(100%);
  }
  .catnav__tab {
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-2);
    transition: color 0.35s var(--ease-out);
  }
  .catnav__tab:hover {
    color: var(--ink);
  }
  .catnav__tab[aria-selected='true'] {
    color: var(--canvas);
  }
  @media (prefers-reduced-motion: reduce) {
    .catnav__thumb {
      transition: none;
    }
  }
  .catnav__scroll {
    display: none;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 0.6rem;
    min-width: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 93%, transparent);
  }
  [data-tab='drinks'] .catnav__scroll[data-scroll-for='drinks'],
  [data-tab='food'] .catnav__scroll[data-scroll-for='food'] {
    display: flex;
  }
  .catnav__scroll::-webkit-scrollbar {
    display: none;
  }
  .catnav__divider {
    flex-shrink: 0;
    width: 1px;
    height: 1.5rem;
    background: var(--line-strong);
    opacity: 0.5;
  }
  .catnav__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
  .catnav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink-2);
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  .catnav__n {
    font-size: 0.66rem;
    color: var(--ink-3);
  }
  .catnav__link.is-active .catnav__n {
    color: color-mix(in srgb, var(--canvas) 70%, transparent);
  }
  .catnav__link:hover {
    color: var(--ink);
  }
  .catnav__link.is-active {
    background: var(--ink);
    color: var(--canvas);
  }
  @media (max-width: 900px) {
    .catnav {
      top: 68px;
    }
    .catnav__inner {
      gap: 0.5rem;
    }
    .catnav__tab {
      padding: 0.35rem 0.6rem;
      font-size: 0.66rem;
    }
  }

  .cat {
    padding-top: var(--space-8);
    scroll-margin-top: 140px;
  }
  .cat__title {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
  }
  .cat__intro {
    margin-top: var(--space-4);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    max-width: 52ch;
  }
  /* A justified row: one height, and every tile as wide as its own photo wants
     to be. Nothing is squeezed into a foreign shape, so no glass gets cut. */
  .cat__photos {
    display: flex;
    gap: var(--col-gap);
    margin-top: var(--space-6);
    height: clamp(250px, 29vw, 440px);
  }
  .cat__photo {
    flex: var(--ar, 1.5) 1 0;
    min-width: 0;
    height: 100%;
  }
  .cat__photo img {
    transition: transform 0.9s var(--ease-out);
  }
  .cat__photo:hover img {
    transform: scale(1.05);
  }
  .cat__photo:hover .cat__caption {
    padding-bottom: 1.15rem;
  }
  /* A category with a single photo pairs it with a written panel */
  .cat__solo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--col-gap);
    align-items: stretch;
    margin-top: var(--space-6);
  }
  .cat__solo .cat__photo {
    aspect-ratio: var(--ar, 1.33);
    height: auto;
  }
  .cat__solo-copy {
    display: grid;
    align-content: center;
    gap: 0.75rem;
    padding: var(--space-6);
    background: var(--canvas-2);
    transition: background-color var(--dur-theme) var(--ease-inout);
  }
  .cat__solo-name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
