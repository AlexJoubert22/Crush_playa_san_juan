---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400-italic.css';
// Instrument Serif has no Cyrillic; Playfair steps in for the Russian italics.
import '@fontsource/playfair-display/400-italic.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { site, analytics } from '@/data/site';
import { languages, langs, localise, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';

interface Props {
  title: string;
  description?: string;
  theme?: 'day' | 'night' | 'sunset';
  page?: string;
  ogImage?: string;
  lang?: Lang;
  /** Canonical (English) path of this page, for the hreflang pair. */
  path?: string;
}

const {
  title,
  description = site.description,
  theme = 'day',
  page = '',
  ogImage = '/og.jpg',
  lang = 'en',
  path = '/',
} = Astro.props;

const c = t(lang);
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(localise(lang, path), base).href;
const ogUrl = new URL(ogImage, base).href;
const themeColor = theme === 'night' ? '#0b090e' : theme === 'sunset' ? '#f3e4dd' : '#f4efe6';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['BarOrPub', 'CafeOrCoffeeShop'],
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: ogUrl,
  servesCuisine: ['Brunch', 'Coffee', 'Cocktails', 'Cuban sandwiches', 'Açaí bowls'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postal,
    addressCountry: 'ES',
  },
  inLanguage: languages[lang].htmlLang,
  sameAs: [site.instagram, site.facebook, site.tiktok, site.tripadvisor],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '23:00' },
  ],
};

/** The words the client script needs: live status, chip lines, calendar labels. */
const clientCopy = {
  status: c.status,
  chip: c.chip,
  nowLabel: c.home.daylineNow,
  closedLabel: c.home.daylineClosed,
};
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-theme={theme} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(localise(l, path), base).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, base).href} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} data-theme-color />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crush — Playa de San Juan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={languages[lang].locale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/json" id="crush-copy" set:html={JSON.stringify(clientCopy)} />
    {
      analytics.domain && (
        <script defer data-domain={analytics.domain} src={analytics.src} is:inline />
      )
    }
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Nav lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
