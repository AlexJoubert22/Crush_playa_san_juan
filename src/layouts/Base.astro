---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400-italic.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description?: string;
  theme?: 'day' | 'night' | 'sunset';
  page?: string;
  ogImage?: string;
}

const {
  title,
  description = site.description,
  theme = 'day',
  page = '',
  ogImage = '/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;
const themeColor = theme === 'night' ? '#0b0910' : theme === 'sunset' ? '#f3e4dd' : '#f4efe6';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['BarOrPub', 'CafeOrCoffeeShop'],
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: ogUrl,
  servesCuisine: ['Brunch', 'Coffee', 'Cocktails', 'Cuban sandwiches', 'Açaí bowls'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postal,
    addressCountry: 'ES',
  },
  sameAs: [site.instagram, site.facebook],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '23:00' },
  ],
};
---

<!doctype html>
<html lang="en" data-theme={theme} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} data-theme-color />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crush — Playa de San Juan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
