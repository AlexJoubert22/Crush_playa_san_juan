---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Strap from '@/components/Strap.astro';
import Arrow from '@/components/Arrow.astro';
import Beat from '@/components/Beat.astro';
import EventsFeed from '@/components/EventsFeed.astro';
import { site, sessions } from '@/data/site';
import djs from '@/data/djs.json';
import menu from '@/data/menu.json';
import { localise, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const L = (p: string) => localise(lang, p);
const txt = (v: { en: string; es: string }) => (lang === 'es' && v.es ? v.es : v.en);
/** Dishes come straight from the menu, so names, prices and language never drift. */
const dish = (nameEn: string) => {
  const found = menu.items.find((i) => i.name.en === nameEn);
  if (!found) throw new Error(`[crush] no menu item called "${nameEn}" — check src/data/menu.json`);
  return found;
};

import towerDay from '@/assets/venue/tower-day.jpg';
import nightSign from '@/assets/venue/noche1.webp';
import cadenzaArt from '@/assets/events/cadenza.webp';
import opusArt from '@/assets/events/opus.webp';

const menuPhotos = import.meta.glob<ImageMetadata>('/src/assets/menu/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const pic = (name: string) => menuPhotos[`/src/assets/menu/${name}`];

/** The morning rail: what's actually on the tables before four. */
const rail = [
  { file: 'acai-bowl.webp', item: 'Açaí Bowl 300g' },
  { file: 'el-crush.jpeg', item: 'El Crush' },
  { file: 'benedictinos.jpeg', item: 'Eggs Benedict' },
  { file: 'roma.webp', item: 'Roma' },
  { file: 'revueltos-2.jpeg', item: 'Scrambled Eggs' },
  { file: 'sweet-greek.jpeg', item: 'Sweet Greek' },
  { file: 'oh-my-lemon.jpeg', item: 'French Kiss' },
  { file: 'santiago.webp', item: 'Santiago' },
  { file: 'tio-sam.webp', item: 'Tio Sam' },
  { file: 'cosmo.webp', item: 'Cosmo' },
].map((r) => ({ ...r, dish: dish(r.item) }));

/** Three ways to start, one per column. */
const triptych = [
  { file: 'iberia.jpeg', kicker: c.triptychKickers.toast, item: 'Iberia' },
  { file: 'royale.jpeg', kicker: c.triptychKickers.eggs, item: 'Eggs Royale' },
  { file: 'luna-rossa-2.jpeg', kicker: c.triptychKickers.french, item: 'Luna Rosa' },
].map((r) => ({ ...r, dish: dish(r.item) }));

const dayEssentials = [
  'Açaí Bowl 300g',
  'Iced Strawberry Matcha',
  'El Crush',
  'Flat White',
  'Eggs Benedict',
  'Iced Latte',
  'Espresso & Tonic',
  'Sweet Greek',
  'Crush Club',
].map(dish);

const lattes = [
  { name: c.flavours.blueberry, c: '#6b5aa6' },
  { name: c.flavours.coconutCaramel, c: '#c9a27e' },
  { name: c.flavours.pistachio, c: '#9fbd7c' },
  { name: c.flavours.strawberry, c: '#e9748d' },
  { name: c.flavours.vanilla, c: '#efe0bd' },
  { name: c.flavours.mocha, c: '#6a4838' },
  { name: c.flavours.iceCream, c: '#f6efe0' },
];
const matchas = [
  { name: c.flavours.cherry, c: '#b4304f' },
  { name: c.flavours.mango, c: '#f2b544' },
  { name: c.flavours.passionFruit, c: '#e58a2a' },
  { name: c.flavours.strawberry, c: '#e9748d' },
  { name: c.flavours.vanilla, c: '#efe0bd' },
  { name: c.flavours.yuzu, c: '#d9d94a' },
];
const sunsetPours = [
  'Aperol Spritz',
  'Hugo Spritz',
  'Paloma Premium',
  'Summer Crush',
  'Cloud Nine',
  'Espresso Martini',
].map(dish);

const nightFacts = [
  { k: c.home.factResidents, v: c.home.factResidentsV },
  { k: c.home.factSessions, v: 'Cadenza · OPUS' },
  { k: c.home.factSound, v: c.home.factSoundV },
  { k: c.home.factLast, v: '02:00' },
];
const dayline = [
  { id: 'day', from: 9, to: 17, label: c.home.segDay, sub: c.home.segDaySub },
  { id: 'sunset', from: 17, to: 21, label: c.home.segSunset, sub: c.home.segSunsetSub },
  { id: 'night', from: 21, to: 26, label: c.home.segNight, sub: c.home.segNightSub },
];
const ticks = ['09:00', '12:00', '17:00', '21:00', '02:00'];
const eur = (n: number | null) => (n == null ? '' : `€${Number.isInteger(n) ? n : n.toFixed(2)}`);
---

<Base
  title={c.home.title}
  description={c.home.heroLede}
  theme="day"
  page="home"
  lang={lang}
  path="/"
>
  <div data-arc>
    <!-- ========================================================= HERO -->
    <section class="hero" data-chapter-theme="day" data-hour="9">
      <div class="hero__copy">
        <Strap class="hero__strap" data-reveal="fade" />
        <h1 class="display-xl hero__title" data-reveal="lines">
          {c.home.heroA} <span class="em">{c.home.heroCoffee}</span> {c.home.heroB} <span class="em">{c.home.heroBeat}</span>
        </h1>
        <p class="lede hero__lede" data-reveal="fade" style="--reveal-delay: 380ms">
          {c.home.heroLede}
        </p>
        <div class="hero__actions" data-reveal="fade" style="--reveal-delay: 520ms">
          <a href={L('/events')} class="btn">{c.home.heroCtaEvents} <Arrow /></a>
          <a href={L('/menu')} class="btn btn--ghost">{c.home.heroCtaMenu}</a>
        </div>
        <div class="hero__meta" data-reveal="fade" style="--reveal-delay: 700ms">
          <span>{site.address.street} · {site.address.area}, {site.address.city}</span>
          <span class="num">{c.status.openDaily}</span>
        </div>
      </div>

      <div class="hero__media media" data-reveal="clip">
        <div class="hero__media-inner" data-parallax="10">
          <Image
            src={towerDay}
            alt="A lifeguard tower painted in Miami stripes on the sand of Playa de San Juan, Alicante"
            widths={[640, 960, 1280, 1707]}
            sizes="(max-width: 900px) 100vw, 60vw"
            class="reveal-scale hero__img"
            priority
          />
        </div>
        <div class="hero__scroll" aria-hidden="true">
          <span class="num hero__scroll-clock" data-hero-clock>09:00</span>
          <span class="label">{c.nav.scrollLabel}</span>
          <Arrow dir="down" class="hero__scroll-arrow" />
        </div>
      </div>
    </section>

    <!-- ================================================ A DAY AT CRUSH -->
    <section class="dayline" aria-label={c.home.daylineTitle}>
      <div class="wrap">
        <div class="dayline__head">
          <p class="label">{c.home.daylineTitle}</p>
          <p class="label dayline__now-label" data-dayline-label>{c.home.daylineTz}</p>
        </div>
        <div class="dayline__track" data-dayline>
          {
            dayline.map((s) => (
              <a
                href={`#${s.id}`}
                class={`dayline__seg dayline__seg--${s.id}`}
                style={`--from:${s.from};--to:${s.to}`}
              >
                <span class="dayline__seg-label">{s.label}</span>
                <span class="dayline__seg-sub">{s.sub}</span>
              </a>
            ))
          }
          <span class="dayline__marker" data-dayline-marker hidden>
            <span class="dayline__marker-time num" data-dayline-time>17:00</span>
          </span>
        </div>
        <ol class="dayline__ticks num" aria-hidden="true">
          {ticks.map((t, i) => <li style={`--h:${[9, 12, 17, 21, 26][i]}`}>{t}</li>)}
        </ol>
      </div>
    </section>

    <!-- ===================================================== 01 · DAY -->
    <section class="chapter section" id="day" data-chapter-theme="day" data-hour="11">
      <div class="wrap">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">01</span>
          <span class="label">{c.home.dayChapter}</span>
          <span class="label label--display">{c.home.dayLabel}</span>
        </div>

        <div class="grid day__grid">
          <!-- Left: everything editorial. Right: the reel, whole, untouched. -->
          <div class="day__left">
            <h2 class="display" data-reveal="lines">{c.home.dayTitleA} <span class="em">{c.home.dayTitleEm}</span></h2>
            <div class="chapter__text" data-reveal="fade">
              <p class="body">
                {c.home.dayP1}
              </p>
              <p class="body">
                Açaí bowls built to order. Eggs on brioche, gourmet toast with burrata or serrano, French
                toast when the day calls for it. Breakfast slides into brunch, brunch into a long lunch, and
                nobody asks you to leave.
              </p>
            </div>
            <a href={L('/menu')} class="link-line chapter__link" data-reveal="fade">{c.home.dayLink}</a>

            <div class="flavours" data-reveal="fade">
              <div class="flavours__group">
                <p class="label muted">Iced lattes, seven ways <span class="num">· €4.50 – 5.50</span></p>
                <ul class="flavours__list">
                  {lattes.map((f) => <li style={`--c:${f.c}`}><i></i>{f.name}</li>)}
                </ul>
              </div>
              <div class="flavours__group">
                <p class="label muted">Matcha, six ways <span class="num">· €5.50</span></p>
                <ul class="flavours__list">
                  {matchas.map((f) => <li style={`--c:${f.c}`}><i></i>{f.name}</li>)}
                </ul>
              </div>
            </div>

            <div class="house" data-reveal="fade">
              <p class="label muted house__label">{c.home.houseLabel}</p>
              <p class="body">
                {c.home.houseP1}
              </p>
              <p class="body">
                {c.home.houseP2}
              </p>
            </div>
          </div>

          <figure class="reel day__reel" data-reveal="clip">
            <video
              class="reveal-scale"
              data-reel
              muted
              loop
              playsinline
              preload="none"
              poster="/video/morning-poster.jpg"
              aria-label="An iced strawberry matcha being poured at the Crush bar"
            >
              <source src="/video/morning.mp4" type="video/mp4" />
            </video>
            <span class="reel__tag" aria-hidden="true"><i></i>{c.home.reelMorning}</span>
            <figcaption class="reel__cap"><span>{c.home.reelMorningCap}</span><span class="num">€5.50</span></figcaption>
          </figure>
        </div>

        <div class="listing">
          <div class="listing__head">
            <p class="label muted">{c.home.essentials}</p>
            <a href={L('/menu')} class="link-line small listing__link">{c.home.essentialsLink}</a>
          </div>
          <ul class="rule-list listing__list" data-stagger>
            {
              dayEssentials.map((i) => (
                <li>
                  <span class="row__name">{txt(i.name)}</span>
                  <span class="row__price">{eur(i.price)}</span>
                  <span class="row__desc">{txt(i.description)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- The rail: the counter, passing by -->
      <div class="rail" aria-label={c.home.railLabel}>
        <div class="rail__track">
          {
            [0, 1].map((dup) => (
              <ul class="rail__list" aria-hidden={dup === 1 ? 'true' : undefined}>
                {rail.map((r) => (
                  <li class="rail__item">
                    <figure class="media rail__media">
                      <Image src={pic(r.file)} alt={txt(r.dish.name)} widths={[280, 480]} sizes="260px" />
                    </figure>
                    <figcaption class="rail__cap">
                      <span>{txt(r.dish.name)}</span>
                      <span class="num">{eur(r.dish.price)}</span>
                    </figcaption>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <div class="wrap">
        <div class="triptych">
          <div class="triptych__head">
            <p class="label muted">{c.home.triptych}</p>
            <a href={L('/menu')} class="link-line small">{c.home.triptychLink}</a>
          </div>
          <div class="triptych__grid">
            {
              triptych.map((t, i) => (
                <article class="tri" data-reveal="fade" style={`--reveal-delay: ${i * 110}ms`}>
                  <figure class="media tri__media">
                    <Image
                      src={pic(t.file)}
                      alt={txt(t.dish.name)}
                      widths={[420, 700, 1000]}
                      sizes="(max-width: 900px) 100vw, 31vw"
                    />
                  </figure>
                  <p class="label muted tri__kicker">{t.kicker}</p>
                  <h3 class="tri__name">
                    {txt(t.dish.name)}
                    <span class="num tri__price">{eur(t.dish.price)}</span>
                  </h3>
                  <p class="small muted tri__desc">{txt(t.dish.description)}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================== 02 · SUNSET -->
    <section class="chapter section" id="sunset" data-chapter-theme="sunset" data-hour="17">
      <div class="wrap">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">02</span>
          <span class="label">{c.home.sunsetChapter}</span>
          <span class="label label--display">{c.home.sunsetLabel}</span>
        </div>

        <div class="sunset__intro">
          <h2 class="display sunset__title" data-reveal="lines">
            {c.home.sunsetTitleA} <span class="em">{c.home.sunsetTitleEm}</span> {c.home.sunsetTitleB}
          </h2>
          <p class="lede sunset__lede" data-reveal="fade">
            {c.home.sunsetLede}
          </p>
        </div>

        <div class="sunset__grid">
          <figure class="reel sunset__reel" data-reveal="clip">
            <video
              class="reveal-scale"
              data-reel
              muted
              loop
              playsinline
              preload="none"
              poster="/video/afterbeach-poster.jpg"
              aria-label="A Crush bartender shaking and pouring a cocktail"
            >
              <source src="/video/afterbeach.mp4" type="video/mp4" />
            </video>
            <span class="reel__tag" aria-hidden="true"><i></i>{c.home.reelBar}</span>
            <figcaption class="reel__cap"><span>{c.home.reelBarCap}</span><span class="num">17:00 →</span></figcaption>
          </figure>

          <div class="sunset__side">
            <p class="label muted">{c.home.pours}</p>
            <ul class="rule-list sunset__list" data-stagger>
              {
                sunsetPours.map((i) => (
                  <li>
                    <span class="row__name">{txt(i.name)}</span>
                    <span class="row__price">{eur(i.price)}</span>
                    <span class="row__desc">{txt(i.description)}</span>
                  </li>
                ))
              }
            </ul>
            <div class="sunset__foot">
              <p class="small muted">{c.home.poursNote}</p>
              <a href={L('/menu')} class="link-line small">{c.home.poursLink}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================== 03 · NIGHT -->
    <section class="night" id="night" data-chapter-theme="night" data-hour="21">
      <div class="night__stage grain">
        <div class="wrap night__content">
          <div class="chapter-head chapter-head--night" data-reveal="fade">
            <span class="num">03</span>
            <span class="label">{c.home.nightChapter}</span>
            <span class="label label--display">{c.home.nightLabel}</span>
          </div>

          <div class="night__grid">
            <figure class="media night__photo" data-reveal="clip">
              <Image
                src={nightSign}
                alt="A guest with a cocktail under the pink Crush neon sign at night"
                widths={[540, 800, 1086]}
                sizes="(max-width: 900px) 100vw, 40vw"
                class="reveal-scale"
              />
              <figcaption class="cap"><span>{c.home.nightPhotoCap}</span><span class="num">23:40</span></figcaption>
            </figure>

            <div class="night__copy">
              <span class="neon-rule" aria-hidden="true" data-reveal="fade"></span>
              <h2 class="display night__title" data-reveal="lines">
                {c.home.nightTitleA} <span class="em">{c.home.nightTitleEm}</span>
              </h2>
              <p class="body night__text" data-reveal="fade">
                {c.home.nightText}
              </p>
              <ul class="rule-list night__facts" data-stagger>
                {
                  nightFacts.map((f) => (
                    <li>
                      <span class="row__name">{f.k}</span>
                      <span class="row__price night__fact">{f.v}</span>
                    </li>
                  ))
                }
              </ul>
              <a href={L('/sound')} class="btn btn--light" data-reveal="fade">{c.home.nightCta} <Arrow /></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Line-up board -->
      <div class="ticker" aria-label={c.home.tickerLabel}>
        <div class="ticker__track">
          {
            [0, 1].map((dup) => (
              <ul class="ticker__list" aria-hidden={dup === 1 ? 'true' : undefined}>
                {djs.map((d) => (
                  <li class="ticker__item">
                    <span class="ticker__name">{d.name}</span>
                    <span class="ticker__genre">{d.genre}</span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================== SESSIONS + AGENDA -->
    <section class="section sessions" id="sessions" data-hour="23">
      <div class="wrap">
        <div class="grid sessions__grid">
          <article class="session" data-reveal="fade">
            <figure class="media media--16x10 session__art">
              <Image src={cadenzaArt} alt="Cadenza" widths={[400, 600]} sizes="(max-width: 900px) 100vw, 45vw" />
            </figure>
            <div class="session__body">
              <p class="label muted">{sessions.cadenza.when} · <span class="num">{sessions.cadenza.time}</span></p>
              <h3 class="h2">{sessions.cadenza.name}</h3>
              <p class="body">{sessions.cadenza.blurb}</p>
              <p class="small muted">{sessions.cadenza.artist} · {sessions.cadenza.genre}</p>
            </div>
          </article>
          <article class="session session--opus" data-reveal="fade" style="--reveal-delay: 120ms">
            <figure class="media media--16x10 session__art session__art--opus">
              <Image src={opusArt} alt="OPUS" widths={[600, 1137]} sizes="(max-width: 900px) 100vw, 45vw" />
            </figure>
            <div class="session__body">
              <p class="label muted">{sessions.opus.when} · <span class="num">{sessions.opus.time}</span></p>
              <h3 class="h2 session__title">{sessions.opus.name} <Beat /></h3>
              <p class="body">{sessions.opus.blurb}</p>
              <p class="small muted">{sessions.opus.artist} · {sessions.opus.genre}</p>
            </div>
          </article>
        </div>

        <div class="agenda" id="agenda">
          <div class="chapter-head" data-reveal="fade">
            <span class="num">→</span>
            <span class="label">{c.home.nextUp}</span>
            <a href={L('/events')} class="label link-line">{c.home.fullAgenda}</a>
          </div>
          <ul class="rule-list agenda__list" data-agenda="4">
            <li class="agenda__row">
              <span class="agenda__date num">Sat & Sun</span>
              <span class="agenda__name">Cadenza</span>
              <span class="agenda__time num">10:00 – 16:00</span>
              <span class="agenda__meta">Resident DJs · Daytime sessions</span>
            </li>
            <li class="agenda__row">
              <span class="agenda__date num">2nd Saturday</span>
              <span class="agenda__name">OPUS</span>
              <span class="agenda__time num">21:00 – 02:00</span>
              <span class="agenda__meta">Many DJs · Progressive house</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================================================ THE FOUNDER -->
    <section class="section story-teaser" data-chapter-theme="night" data-hour="26">
      <div class="wrap">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">PS</span>
          <span class="label">{c.home.founderChapter}</span>
          <span class="label label--display">{c.home.founderPlace}</span>
        </div>
        <div class="story-teaser__grid">
          <blockquote class="story-teaser__quote">
            <span class="story-teaser__mark" aria-hidden="true">“</span>
            <p class="story-teaser__text" data-reveal="lines">
              {c.home.founderQuote}
            </p>
            <footer class="story-teaser__cite" data-reveal="fade">
              <p class="story-teaser__kicker">{c.home.founderKicker}</p>
              <span class="story-teaser__name">{c.home.founderName}</span>
              <span class="muted small">{c.home.founderRole}</span>
            </footer>
            <a href={L('/story')} class="btn btn--ghost story-teaser__btn" data-reveal="fade" style="--reveal-delay: 120ms">{c.home.founderCta} <Arrow /></a>
          </blockquote>
          <figure class="reel story-teaser__reel" data-reveal="clip">
            <video
              class="reveal-scale"
              data-reel
              muted
              loop
              playsinline
              preload="none"
              poster="/video/belong-poster.jpg"
              aria-label="Playa de San Juan from above, the beach, the bar and the terrace at Crush"
            >
              <source src="/video/belong.mp4" type="video/mp4" />
            </video>
            <span class="reel__tag" aria-hidden="true"><i></i>{c.home.reelBelong}</span>
            <figcaption class="reel__cap"><span>{c.home.reelBelongCapA}</span><span>{c.home.reelBelongCapB}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ================================================== 04 · AGAIN -->
    <section class="section visit" id="visit" data-chapter-theme="day" data-hour="33">
      <div class="wrap">
        <div class="chapter-head" data-reveal="fade">
          <span class="num">04</span>
          <span class="label">{c.home.visitChapter}</span>
          <span class="label label--display">{c.home.visitLabel}</span>
        </div>
        <div class="grid visit__grid">
          <div class="visit__copy">
            <h2 class="display" data-reveal="lines">{c.home.visitTitleA} <span class="em">{c.home.visitTitleEm}</span></h2>
            <address class="visit__address lede" data-reveal="fade">
              {site.address.street}<br />
              {site.address.postal} {site.address.area}, {site.address.city}
            </address>
            <div class="visit__actions" data-reveal="fade" style="--reveal-delay: 120ms">
              <a href={L('/book')} class="btn">{c.home.visitCta} <Arrow /></a>
              <a href={site.instagram} target="_blank" rel="noopener" class="btn btn--ghost">{site.instagramHandle}</a>
            </div>
          </div>
          <div class="visit__hours">
            <p class="label muted">{c.footer.hours}</p>
            <ul class="rule-list" data-stagger>
              {
                site.hours.map((h) => (
                  <li>
                    <span class="row__name">{h.days}</span>
                    <span class="row__price">
                      {h.open} – {h.close}
                    </span>
                  </li>
                ))
              }
              <li>
                <span class="row__name">{c.home.hoursEvents}</span>
                <span class="row__price muted">{c.home.hoursExtended}</span>
                <span class="row__desc">{c.home.hoursEventsNote}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>

  <EventsFeed lang={lang} />
</Base>

<style>
  /* ---------------- shared bits ---------------- */
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 1rem 0.9rem;
    color: #fff;
    font-size: var(--text-small);
    font-weight: 600;
