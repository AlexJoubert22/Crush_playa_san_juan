      border-top-color: var(--line);
    }
  }
  @media (max-width: 900px) {
    .listing {
      padding-top: var(--space-7);
    }
    .listing__list {
      grid-template-columns: 1fr;
    }
    .listing__list > li:nth-child(n + 2) {
      border-top-color: var(--line);
    }
  }

  /* ---------------- HERO ---------------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    min-height: 100svh;
    align-items: stretch;
  }
  .hero__copy {
    display: grid;
    align-content: end;
    gap: var(--space-5);
    padding: 120px var(--space-7) var(--space-7) var(--gutter);
  }
  .hero__strap {
    color: var(--ink-2);
  }
  .hero__title {
    font-size: clamp(2.75rem, 5.7vw, 6.25rem);
    max-width: 10ch;
  }
  .hero__lede {
    max-width: 44ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--text-small);
    color: var(--ink-2);
  }
  .hero__media {
    position: relative;
    min-height: 100svh;
  }
  .hero__media-inner {
    position: absolute;
    inset: -6% 0;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 55%;
  }
  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-6);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(20, 18, 26, 0.55);
    color: var(--day-canvas);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: 0.8rem;
  }
  .hero__scroll-clock {
    font-size: 1rem;
  }
  .hero__scroll .label {
    color: rgba(244, 239, 230, 0.8);
  }
  .hero__scroll :global(.hero__scroll-arrow) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    animation: nudge 2.2s var(--ease-inout) infinite;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: rotate(90deg) translateX(0);
    }
    50% {
      transform: rotate(90deg) translateX(4px);
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero__media {
      order: -1;
      min-height: 0;
      height: 66svh;
      margin-top: 68px;
    }
    .hero__copy {
      padding: var(--space-6) var(--gutter) var(--space-7);
      gap: var(--space-4);
    }
    .hero__title {
      max-width: none;
      font-size: clamp(2.75rem, 12vw, 4.5rem);
    }
    .hero__scroll {
      bottom: var(--space-4);
      right: var(--gutter);
    }
  }

  /* ---------------- DAYLINE ---------------- */
  .dayline {
    padding-block: var(--space-6) var(--space-3);
    border-top: 1px solid var(--line-strong);
  }
  .dayline__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    color: var(--ink-2);
  }
  .dayline__track {
    position: relative;
    display: grid;
    grid-template-columns: 8fr 4fr 5fr; /* 9→17, 17→21, 21→02 */
    gap: 6px;
    height: 88px;
  }
  .dayline__seg {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem;
    border-top: 3px solid var(--seg);
    color: var(--ink);
  }
  .dayline__seg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--seg);
    opacity: 0.08;
    transition: opacity var(--dur-standard) var(--ease-out);
  }
  .dayline__seg:hover::before {
    opacity: 0.18;
  }
  .dayline__seg--day {
    --seg: var(--turquoise);
  }
  .dayline__seg--sunset {
    --seg: var(--magenta);
  }
  .dayline__seg--night {
    --seg: var(--glow);
  }
  .dayline__seg-label {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .dayline__seg-sub {
    position: relative;
    font-size: var(--text-small);
    color: var(--ink-3);
  }
  .dayline__marker {
    position: absolute;
    top: -3px;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--ink);
    transform: translateX(-50%);
    transition: left 1s var(--ease-inout);
  }
  .dayline__marker[hidden] {
    display: none;
  }
  .dayline__marker::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    transform: translateX(-50%);
    box-shadow: 0 0 0 4px var(--canvas);
  }
  .dayline__marker-time {
    position: absolute;
    top: -34px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--canvas);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .dayline__ticks {
    position: relative;
    height: 1.2rem;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .dayline__ticks li {
    position: absolute;
    top: 0;
    left: calc((var(--h) - 9) / 17 * 100%);
    transform: translateX(-50%);
  }
  .dayline__ticks li:first-child {
    transform: none;
  }
  .dayline__ticks li:last-child {
    transform: translateX(-100%);
  }
  @media (max-width: 760px) {
    .dayline__track {
      height: 76px;
    }
    .dayline__seg {
      padding: 0.5rem 0.6rem;
    }
    .dayline__seg-sub {
      display: none;
    }
    .dayline__seg-label {
      font-size: 0.85rem;
    }
    .dayline__ticks li:nth-child(2) {
      display: none;
    }
  }

  /* ---------------- DAY ---------------- */
  .day__grid {
    padding-top: var(--space-7);
    align-items: start;
  }
  .day__left {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .chapter__text {
    display: grid;
    gap: 1em;
  }
  .chapter__text .body {
    max-width: none;
  }
  .chapter__link {
    font-weight: 600;
    justify-self: start;
  }
  .day__reel {
    grid-column: 8 / -1;
    aspect-ratio: 9 / 16;
    align-self: start;
  }
  .flavours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--col-gap);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-strong);
  }
  .flavours__group:first-child {
    padding-top: var(--space-3);
  }
  .flavours__group:last-child {
    padding-top: var(--space-3);
  }
  .flavours__group {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .flavours__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
  }
  .flavours__list li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .flavours__list i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(20, 18, 26, 0.12);
    transition: transform var(--dur-standard) var(--ease-out);
  }
  .flavours__list li:hover i {
    transform: scale(1.35);
  }
  /* The written note that closes the left column */
  .house {
    display: grid;
    gap: 1em;
    padding-top: var(--space-5);
    margin-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .house__label {
    margin-bottom: 0.2rem;
  }
  /* Same measure and size as the paragraphs above, so the column reads as one */
  .house .body {
    max-width: none;
  }
  @media (max-width: 900px) {
    .day__left,
    .day__reel {
      grid-column: 1 / -1;
    }
    .day__reel {
      order: -1;
      width: min(100%, 420px);
      justify-self: center;
    }
  }
  @media (max-width: 560px) {
    .flavours {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- RAIL (infinite product marquee) ---------------- */
  .rail {
    overflow: hidden;
    margin-top: var(--space-8);
    padding-block: var(--space-5);
    border-block: 1px solid var(--line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .rail__track {
    display: flex;
    width: max-content;
    animation: rail 64s linear infinite;
  }
  .rail:hover .rail__track {
    animation-play-state: paused;
  }
  .rail__list {
    display: flex;
    flex-shrink: 0;
  }
  .rail__item {
    flex: 0 0 auto;
    width: clamp(190px, 17vw, 260px);
    margin-right: var(--col-gap);
  }
  .rail__media {
    aspect-ratio: 4 / 3;
  }
  .rail__media img {
    transition: transform 0.7s var(--ease-out);
  }
  .rail__item:hover .rail__media img {
    transform: scale(1.06);
  }
  .rail__cap {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.6rem;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .rail__cap .num {
    color: var(--ink-2);
  }
  @keyframes rail {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail {
      overflow-x: auto;
    }
    .rail__track {
      animation: none;
    }
    .rail__list[aria-hidden] {
      display: none;
    }
  }

  /* ---------------- TRIPTYCH ---------------- */
  .triptych {
    padding-top: var(--space-7);
  }
  .triptych__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line-strong);
  }
  .triptych__head .link-line {
    font-weight: 600;
  }
  .triptych__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) calc(var(--col-gap) * 2);
    padding-top: var(--space-6);
  }
  .tri {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  /* 4:3 — wide enough that the landscape plates keep their edges, tall enough
     that the vertical shot reads as a dish and not a sliver. */
  .tri__media {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-3);
  }
  .tri__media img {
    transition: transform 0.8s var(--ease-out);
  }
  .tri:hover .tri__media img {
    transform: scale(1.04);
  }
  .tri__kicker {
    color: var(--accent-ink);
  }
  .tri__name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tri__price {
    color: var(--ink-2);
    font-size: 0.9em;
  }
  .tri__desc {
    max-width: 34ch;
  }
  @media (max-width: 900px) {
    .triptych__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .tri__media {
      aspect-ratio: 16 / 10;
    }
  }

  /* ---------------- SUNSET ---------------- */
  .sunset__intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6);
    align-items: end;
    padding-top: var(--space-7);
  }
  .sunset__title {
    max-width: 12ch;
  }
  .sunset__lede {
    max-width: 40ch;
    padding-bottom: 0.35em;
  }
  .sunset__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-6) calc(var(--col-gap) * 2);
    align-items: start;
    margin-top: var(--space-7);
  }
  .sunset__reel {
    aspect-ratio: 4 / 5;
  }
  .sunset__side {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }
  .sunset__list .row__name {
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
  }
  .sunset__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: var(--space-2);
  }
  .sunset__foot .link-line {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .sunset__intro,
    .sunset__grid {
      grid-template-columns: 1fr;
    }
    .sunset__title {
      max-width: none;
    }
    .sunset__reel {
      width: 80%;
    }
  }

  /* ---------------- NIGHT ---------------- */
  .night {
    color: var(--night-ink);
  }
  .night__stage {
    position: relative;
    background: var(--night-canvas);
    overflow: hidden;
  }
  .night__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-section) var(--space-8);
    display: grid;
    gap: var(--space-7);
  }
  .chapter-head--night {
    border-color: rgba(244, 239, 230, 0.45);
  }
  .chapter-head--night .label {
    color: rgba(244, 239, 230, 0.8);
  }
  .chapter-head--night .num {
    color: var(--night-accent);
  }
  .night__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-6) calc(var(--col-gap) * 2);
    align-items: center;
  }
  .night__photo {
    aspect-ratio: 3 / 4;
  }
  .night__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-inline-start: clamp(0px, 3vw, 40px);
  }
  .neon-rule {
    display: block;
    height: 2px;
    width: min(100%, 220px);
    background: var(--night-accent);
    box-shadow:
      0 0 10px var(--glow),
      0 0 28px var(--glow-mid);
  }
  .night__title {
    max-width: 11ch;
    text-shadow: 0 0 44px var(--glow-soft);
  }
  .night__title .em {
    color: var(--night-accent-ink);
  }
  .night__text {
    color: rgba(244, 239, 230, 0.85);
    max-width: 48ch;
  }
  .night__facts {
    width: 100%;
    border-top-color: rgba(244, 239, 230, 0.45);
  }
  .night__facts > li {
    padding-block: 0.8rem;
    border-bottom-color: var(--night-line);
  }
  .night__facts .row__name {
    font-size: 0.95rem;
    color: var(--night-ink-2);
  }
  .night__fact {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: right;
  }
  @media (max-width: 900px) {
    .night__grid {
      grid-template-columns: 1fr;
    }
    .night__photo {
      width: 80%;
    }
    .night__copy {
      padding-inline-start: 0;
    }
    .night__title {
      max-width: none;
    }
  }

  /* line-up board */
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--night-line);
    background: var(--night-canvas);
    padding-block: 1.1rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 70s linear infinite;
  }
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }
  .ticker__list {
    display: flex;
    flex-shrink: 0;
  }
  .ticker__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-inline: 2.2rem;
    white-space: nowrap;
    border-right: 1px solid var(--night-line);
  }
  .ticker__name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .ticker__genre {
    font-size: var(--text-small);
    color: var(--night-ink-3);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
    .ticker__list[aria-hidden] {
      display: none;
    }
    .ticker__list {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
  }

  /* ---------------- SESSIONS + AGENDA ---------------- */
  .sessions__grid {
    align-items: start;
  }
  .session {
    grid-column: span 6;
    display: grid;
    gap: var(--space-5);
  }
  .session__art {
    background: #000;
  }
  .session__art img {
    object-fit: contain;
    padding: 6%;
  }
  .session__art--opus img {
    object-fit: cover;
    padding: 0;
    object-position: center 45%;
  }
  .session__body {
    display: grid;
    gap: var(--space-3);
  }
  .session__body .h2 {
    margin-top: 0.25rem;
  }
  .session__title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .agenda {
    padding-top: var(--space-8);
  }
  @media (max-width: 900px) {
    .session {
      grid-column: 1 / -1;
    }
  }

  /* ---------------- THE FOUNDER ---------------- */
  .story-teaser__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) calc(var(--col-gap) * 1.5);
    align-items: center;
    padding-top: var(--space-7);
  }
  .story-teaser__quote {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-top: var(--space-6);
  }
  .story-teaser__mark {
    position: absolute;
    top: -0.25em;
    left: -0.08em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(6rem, 10vw, 11rem);
    line-height: 1;
    color: var(--accent);
    opacity: 0.9;
    pointer-events: none;
  }
  .story-teaser__text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.9rem, 3.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .story-teaser__cite {
    display: grid;
    gap: 0.3rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
