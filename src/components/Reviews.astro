---
/**
 * Social proof, and only what can be verified.
 *
 * Rating, count and quotes come from `reviews.json`, read from the venue's own
 * Google listing. The carousel is a scroll-snap track: the browser does the
 * scrolling, so the gesture is native and smooth on touch, and the script only
 * wires the arrows, the dots and the gentle auto-advance.
 */
import reviews from '@/data/reviews.json';
import type { Lang } from '@/i18n';
import { t } from '@/i18n/copy';
import Arrow from './Arrow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

const locale = { en: 'en-GB', es: 'es-ES', fr: 'fr-FR', ru: 'ru-RU' }[lang];
const nf = new Intl.NumberFormat(locale);
const rating = nf.format(reviews.rating);
const count = nf.format(reviews.count);

/** "review|reviews", or three forms for Russian. */
const plural = (n: number, forms: string) => {
  const f = forms.split('|');
  if (f.length === 3) {
    const m10 = n % 10;
    const m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return f[0];
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return f[1];
    return f[2];
  }
  return n === 1 ? f[0] : f[f.length - 1];
};

const monthFmt = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
const whenOf = (d?: string) => {
  if (!d) return '';
  const [y, m] = d.split('-').map(Number);
  return monthFmt.format(new Date(Date.UTC(y, (m || 1) - 1, 1)));
};

type Quote = {
  author: string;
  stars?: number;
  date?: string;
  reviewer?: { localGuide?: boolean; reviews?: number; photos?: number };
  text: Record<string, string>;
};

/** "Local Guide · 193 reviews · 348 photos", in the page's language. */
const reviewerLine = (r?: Quote['reviewer']) => {
  if (!r) return '';
  const bits: string[] = [];
  if (r.localGuide) bits.push(c.reviews.localGuide);
  if (r.reviews) bits.push(`${nf.format(r.reviews)} ${plural(r.reviews, c.reviews.reviews)}`);
  if (r.photos) bits.push(`${nf.format(r.photos)} ${plural(r.photos, c.reviews.photos)}`);
  return bits.join(' · ');
};
const original = reviews.originalLang ?? 'es';
const quotes = ((reviews.quotes ?? []) as Quote[]).map((q) => ({
  ...q,
  body: q.text[lang] || q.text[original],
  translated: lang !== original && Boolean(q.text[lang]),
  when: whenOf(q.date),
  meta: reviewerLine(q.reviewer),
}));
const pct = Math.max(0, Math.min(100, (reviews.rating / 5) * 100));
---

<section class="reviews" aria-label={c.reviews.head} data-chapter-theme="day" data-hour="30">
  <div class="wrap">
    <div class="chapter-head" data-reveal="fade">
      <span class="num">{rating}</span>
      <span class="label">{c.reviews.head}</span>
      <a href={reviews.url} target="_blank" rel="noopener" class="label link-line">{c.reviews.cta}</a>
    </div>

    <div class="reviews__score" data-reveal="fade">
      <p class="reviews__num num">{rating}</p>
      <div class="reviews__meta">
        <span class="reviews__stars" role="img" aria-label={`${rating} / 5`}>
          <span class="reviews__stars-fill" style={`--pct: ${pct}%`}>★★★★★</span>
          <span class="reviews__stars-bg" aria-hidden="true">★★★★★</span>
        </span>
        <p class="reviews__count">
          <span class="num">{count}</span>
          {' '}{plural(reviews.count, c.reviews.reviews)} {c.reviews.onSource} {reviews.source}
        </p>
      </div>
      <p class="reviews__blurb">{c.reviews.blurb}</p>
      <a href={reviews.url} target="_blank" rel="noopener" class="btn btn--sm reviews__cta">
        {c.reviews.cta} <Arrow dir="up-right" />
      </a>
    </div>
  </div>

  {
    quotes.length > 0 && (
      <div class="rvw" data-reviews>
        <div class="rvw__track" data-rvw-track>
          {
            [false, true].map((clone) => (
              <ul class="rvw__list" aria-hidden={clone ? 'true' : undefined}>
                {quotes.map((qt) => (
                  <li class="rvw__item">
                    <figure class="rvw__card">
                      {qt.stars && (
                        <p class="rvw__stars" role="img" aria-label={`${qt.stars} / 5`}>
                          {'★'.repeat(qt.stars)}
                        </p>
                      )}
                      <blockquote class="rvw__quote">{qt.body}</blockquote>
                      <figcaption class="rvw__by">
                        <span class="rvw__author">{qt.author}</span>
                        <span class="rvw__sub">
                          {qt.when}
                          {qt.meta && ' · '}
                          {qt.meta}
                        </span>
                        {qt.translated && <span class="rvw__translated">{c.reviews.translated}</span>}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
        <p class="rvw__hint small muted">{c.reviews.pause}</p>
      </div>
    )
  }
</section>

<style>
  .reviews {
    padding-block: var(--space-block);
  }
  .reviews__score {
    display: grid;
    /* number · stars+count · the line · the link, all on one row */
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-6);
  }
  .reviews__num {
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .reviews__meta {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }
  /* Five stars, filled to the rating — no rounding up */
  .reviews__stars {
    position: relative;
    /* a grid item stretches by default, and the fill's % would follow it */
    display: inline-block;
    justify-self: start;
    width: max-content;
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  .reviews__stars-bg {
    color: var(--line-strong);
    opacity: 0.35;
  }
  .reviews__stars-fill {
    position: absolute;
    inset: 0;
    width: var(--pct);
    overflow: hidden;
    white-space: nowrap;
    color: var(--accent-ink);
  }
  .reviews__count {
    font-size: var(--text-small);
    color: var(--ink-2);
  }
  .reviews__cta {
    justify-self: end;
  }

  .reviews__blurb {
    max-width: 46ch;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---------------- marquee ---------------- */
  /* Two identical lists flowing left forever; the second is a clone, so the
     seam lands exactly at -50% and the loop is invisible. */
  .rvw {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .rvw__track {
    display: flex;
    width: max-content;
    animation: rvw-flow var(--rvw-dur, 150s) linear infinite;
  }
  .rvw:hover .rvw__track,
  .rvw:focus-within .rvw__track {
    animation-play-state: paused;
  }
  @keyframes rvw-flow {
    to {
      transform: translateX(-50%);
    }
  }
  .rvw__list {
    display: flex;
    flex-shrink: 0;
  }
  .rvw__item {
    flex: 0 0 auto;
    width: clamp(280px, 26vw, 380px);
    margin-right: var(--col-gap);
    display: flex;
  }
  .rvw__card {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: color-mix(in srgb, var(--ink) 3%, var(--canvas));
    transition: border-color var(--dur-standard) var(--ease-out);
  }
  .rvw__item:hover .rvw__card {
    border-color: var(--line-strong);
  }
  .rvw__stars {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--accent-ink);
  }
  .rvw__quote {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
  .rvw__by {
    display: grid;
    gap: 0.25rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .rvw__author {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .rvw__sub,
  .rvw__translated {
    font-size: var(--text-small);
    color: var(--ink-3);
  }
  .rvw__translated {
    font-style: italic;
  }
  .rvw__hint {
    margin-top: var(--space-4);
    padding-inline: var(--gutter);
  }

  @media (max-width: 1000px) {
    .rvw {
      --rvw-dur: 120s;
    }
  }
  @media (max-width: 1180px) {
    .reviews__score {
      grid-template-columns: auto auto minmax(0, 1fr);
    }
    .reviews__cta {
      grid-column: 3;
      grid-row: 2;
      justify-self: start;
    }
  }
  @media (max-width: 860px) {
    .reviews__score {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
    }
    .reviews__blurb {
      grid-column: 1 / -1;
      max-width: none;
    }
    .reviews__cta {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  @media (max-width: 700px) {
    .rvw {
      --rvw-dur: 95s;
    }
    .rvw__item {
      width: min(78vw, 320px);
    }
    /* a pointer hint is meaningless on a touch screen */
    .rvw__hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rvw {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .rvw__track {
      animation: none;
    }
    .rvw__list[aria-hidden] {
      display: none;
    }
    .rvw__card {
      transition: none;
    }
  }
</style>
