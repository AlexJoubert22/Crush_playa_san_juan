---
/**
 * The language switch: a two-letter code with a hairline, opening a small
 * list of the four languages. It is a native <details>, so it opens and closes
 * with JavaScript off; app.ts only adds outside-click and Escape.
 */
import { langs, languages, localise, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';

interface Props {
  lang: Lang;
  path: string;
  class?: string;
}
const { lang, path, class: className } = Astro.props;
const c = t(lang);
---

<details class:list={['lang', className]} data-lang>
  <summary class="lang__btn" title={c.nav.langLabel}>
    <span class="sr-only">{c.nav.langLabel}: </span>
    <span class="lang__code">{languages[lang].short}</span>
    <svg class="lang__chev" viewBox="0 0 12 12" aria-hidden="true">
      <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <ul class="lang__menu" role="list">
    {
      langs.map((l) => (
        <li>
          <a
            class:list={['lang__item', { 'is-on': l === lang }]}
            href={localise(l, path)}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span class="lang__code">{languages[l].short}</span>
            <span class="lang__name">{languages[l].label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }
  .lang__btn {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    /* the nav floats over a dark video on the home hero, so the control
       carries its own glass rather than relying on the page behind it */
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--canvas) 72%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.35s var(--ease-out);
  }
  .lang__btn::-webkit-details-marker {
    display: none;
  }
  .lang__btn::marker {
    content: '';
  }
  .lang:hover .lang__btn,
  .lang[open] .lang__btn {
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
  }
  .lang__chev {
    width: 0.7rem;
    height: 0.7rem;
    color: var(--ink-3);
    transition: transform 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }
  .lang[open] .lang__chev {
    transform: rotate(180deg);
    color: var(--ink);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    z-index: 5;
    min-width: 10.5rem;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--canvas) 94%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 18px 50px rgba(20, 18, 26, 0.14);
    animation: lang-in 0.28s var(--ease-out) both;
  }
  .lang__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.7rem;
    border-radius: 9px;
    color: var(--ink-2);
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .lang__item:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
  }
  .lang__item .lang__code {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--ink);
    min-width: 1.6rem;
  }
  .lang__name {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .lang__item.is-on {
    color: var(--ink);
  }
  .lang__item.is-on::after {
    content: '';
    width: 5px;
    height: 5px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
  }
  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lang__menu {
      animation: none;
    }
    .lang__chev,
    .lang__btn,
    .lang__item {
      transition: none;
    }
  }
</style>
