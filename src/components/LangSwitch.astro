---
/**
 * Two letters and a hairline that slides. The whole control is one link to the
 * same page in the other language, so it works with JavaScript off.
 */
import { langs, languages, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';

interface Props {
  lang: Lang;
  path: string;
  class?: string;
}
const { lang, path, class: className } = Astro.props;
---

<a
  class:list={['lang', className]}
  href={lang === 'en' ? (path === '/' ? '/es' : `/es${path}`) : path}
  data-lang-switch
  data-current={lang}
  aria-label={t(lang).nav.langLabel}
  hreflang={lang === 'en' ? 'es' : 'en'}
>
  {
    langs.map((l) => (
      <span class:list={['lang__item', { 'is-on': l === lang }]}>{languages[l].short}</span>
    ))
  }
  <span class="lang__rule" aria-hidden="true"></span>
</a>

<style>
  .lang {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    padding-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--ink-3);
    -webkit-tap-highlight-color: transparent;
  }
  .lang__item {
    text-align: center;
    transition: color 0.45s var(--ease-out);
  }
  .lang__item.is-on {
    color: var(--ink);
  }
  .lang:hover .lang__item:not(.is-on) {
    color: var(--ink-2);
  }
  /* the hairline that travels between the two */
  .lang__rule {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(50% - 0.275rem);
    height: 1px;
    background: var(--ink);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.28, 1);
  }
  .lang[data-current='es'] .lang__rule {
    transform: translateX(calc(100% + 0.55rem));
  }
  @media (prefers-reduced-motion: reduce) {
    .lang__rule,
    .lang__item {
      transition: none;
    }
  }
</style>
