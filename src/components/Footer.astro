---
import { nav, site } from '@/data/site';
import { localise, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';
import Strap from './Strap.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const L = (p: string) => localise(lang, p);
const year = new Date().getFullYear();

const socials = [
  { label: 'Instagram', handle: site.instagramHandle, href: site.instagram, icon: 'instagram' },
  { label: 'TikTok', handle: '@crushplayasanjuan', href: site.tiktok, icon: 'tiktok' },
  { label: 'Facebook', handle: 'Crush Playa de San Juan', href: site.facebook, icon: 'facebook' },
  { label: 'Tripadvisor', handle: 'Read the reviews', href: site.tripadvisor, icon: 'tripadvisor' },
];
---

<footer class="footer">
  <div class="wrap">
    <hr class="rule rule--strong" />
    <div class="footer__grid">
      <div class="footer__col">
        <p class="label muted">{c.footer.visit}</p>
        <address>
          {site.address.street}<br />
          {site.address.postal} {site.address.area}<br />
          {site.address.city}, {site.address.country}
        </address>
        <a class="link-line footer__link" href={site.maps} target="_blank" rel="noopener">{c.footer.directions}</a>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.hours}</p>
        <ul class="footer__hours">
          {
            site.hours.map((h) => (
              <li>
                <span>{h.days}</span>
                <span class="num">
                  {h.open} – {h.close}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="small muted">{site.hoursNote}</p>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.sayHi}</p>
        <a class="link-line footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link-line footer__link" href={site.phoneHref}>{site.phone}</a>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.pages}</p>
        <a class="link-line footer__link" href={L('/')}>{c.nav.home}</a>
        {nav.map((n) => <a class="link-line footer__link" href={L(n.path)}>{c.nav[n.key]}</a>)}
      </div>
    </div>

    <!-- Where to find us the rest of the time -->
    <section class="social" aria-label="Crush on social media">
      <p class="label muted social__label">{c.footer.follow}</p>
      <ul class="social__list">
        {
          socials.map((s) => (
            <li>
              <a class="social__link" href={s.href} target="_blank" rel="noopener">
                <span class="social__icon" aria-hidden="true">
                  {s.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {s.icon === 'tiktok' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M16.5 3h-2.8v12.1a2.5 2.5 0 1 1-2.1-2.5v-2.8a5.3 5.3 0 1 0 4.9 5.3V9.4a6.6 6.6 0 0 0 3.7 1.2V7.8a3.8 3.8 0 0 1-3.7-3.8V3z" />
                    </svg>
                  )}
                  {s.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2v2h-2.6v3h2.6V21h3.3z" />
                    </svg>
                  )}
                  {s.icon === 'tripadvisor' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <circle cx="7.4" cy="13" r="4" />
                      <circle cx="16.6" cy="13" r="4" />
                      <circle cx="7.4" cy="13" r="1.3" fill="currentColor" stroke="none" />
                      <circle cx="16.6" cy="13" r="1.3" fill="currentColor" stroke="none" />
                      <path d="M8.6 7.4a9.6 9.6 0 0 1 6.8 0" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <span class="social__text">
                  <span class="social__name">{s.label}</span>
                  <span class="social__handle">{s.handle}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="footer__mark" aria-hidden="true" data-reveal="lines">Crush</p>

    <div class="footer__bottom">
      <Strap />
      <p class="small muted">© {year} {site.legalName}. {c.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-5);
    color: var(--ink);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--col-gap);
    padding-block: var(--space-6) var(--space-7);
  }
  .footer__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .footer__col .label {
    margin-bottom: 0.4rem;
  }
  .footer__link {
    font-weight: 600;
  }
  .footer__hours {
    display: grid;
    gap: 0.35rem;
    width: 100%;
  }
  .footer__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ---- social ---- */
  .social {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .social__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--col-gap);
  }
  .social__link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition:
      border-color var(--dur-standard) var(--ease-out),
      background-color var(--dur-standard) var(--ease-out),
      transform var(--dur-standard) var(--ease-out);
  }
  .social__link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
  .social__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: border-color var(--dur-standard) var(--ease-out), color var(--dur-standard) var(--ease-out);
  }
  .social__link:hover .social__icon {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .social__icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .social__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .social__name {
    font-weight: 700;
    font-size: 0.92rem;
  }
  .social__handle {
    font-size: var(--text-small);
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .footer__mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(5.5rem, 23.5vw, 27rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    margin-left: -0.04em;
    padding-top: 0.05em;
    color: var(--ink);
    user-select: none;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    margin-top: var(--space-5);
  }
  @media (max-width: 1000px) {
    .social__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .social__list {
      grid-template-columns: 1fr;
    }
  }
</style>
