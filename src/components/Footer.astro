---
import { nav, site } from '@/data/site';
import { localise, type Lang } from '@/i18n';
import { t } from '@/i18n/copy';
import Strap from './Strap.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const L = (p: string) => localise(lang, p);
const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="wrap">
    <hr class="rule rule--strong" />
    <div class="footer__grid">
      <div class="footer__col">
        <p class="label muted">{c.footer.visit}</p>
        <address>
          {site.address.street}<br />
          {site.address.postal} {site.address.area}<br />
          {site.address.city}, {c.country}
        </address>
        <a class="link-line footer__link" href={site.maps} target="_blank" rel="noopener">{c.footer.directions}</a>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.hours}</p>
        <ul class="footer__hours">
          {
            site.hours.map((h, i) => (
              <li>
                <span>{c.hoursDays[i] ?? h.days}</span>
                <span class="num">
                  {h.open} – {h.close}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="small muted">{c.hoursNote}</p>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.sayHi}</p>
        <a class="link-line footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link-line footer__link" href={site.phoneHref}>{site.phone}</a>
      </div>
      <div class="footer__col">
        <p class="label muted">{c.footer.pages}</p>
        <a class="link-line footer__link" href={L('/')}>{c.nav.home}</a>
        {nav.map((n) => <a class="link-line footer__link" href={L(n.path)}>{c.nav[n.key]}</a>)}
        <a class="link-line footer__link footer__legal" href={L('/legal')}>{c.footer.legal}</a>
      </div>
    </div>

    <!-- Where to find us the rest of the time -->
    <section class="social" aria-label={c.alt.social}>
      <p class="label muted social__label">{c.footer.follow}</p>
      <SocialLinks lang={lang} columns={4} />
    </section>

    <p class="footer__mark" aria-hidden="true" data-reveal="lines">Crush</p>

    <div class="footer__bottom">
      <Strap />
      <p class="small muted">© {year} {site.legalName}. {c.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-5);
    color: var(--ink);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--col-gap);
    padding-block: var(--space-6) var(--space-7);
  }
  .footer__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .footer__col .label {
    margin-bottom: 0.4rem;
  }
  .footer__link {
    font-weight: 600;
  }
  .footer__hours {
    display: grid;
    gap: 0.35rem;
    width: 100%;
  }
  .footer__hours li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.15rem 1rem;
  }
  /* "Понедельник – Четверг" is long: the label may wrap, the time never does */
  .footer__hours .num {
    white-space: nowrap;
  }

  /* ---- social ---- */
  .social {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .footer__mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(5.5rem, 23.5vw, 27rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    margin-left: -0.04em;
    padding-top: 0.05em;
    color: var(--ink);
    user-select: none;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    margin-top: var(--space-5);
  }
  @media (max-width: 1000px) {
    .social__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .social__list {
      grid-template-columns: 1fr;
    }
  }
</style>
