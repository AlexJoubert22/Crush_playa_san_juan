---
/**
 * The venue's four social accounts, as cards. Used in the footer and under the
 * map on the booking page, so the icons live in one place.
 *
 * `columns` sets how many fit per row on a wide screen; the grid collapses on
 * its own below that.
 */
import { site } from '@/data/site';
import type { Lang } from '@/i18n';
import { t } from '@/i18n/copy';

interface Props {
  lang: Lang;
  columns?: number;
  class?: string;
}
const { lang, columns = 4, class: className } = Astro.props;
const c = t(lang);

const socials = [
  { label: 'Instagram', handle: site.instagramHandle, href: site.instagram, icon: 'instagram' },
  { label: 'TikTok', handle: '@crushplayasanjuan', href: site.tiktok, icon: 'tiktok' },
  { label: 'Facebook', handle: 'Crush Playa de San Juan', href: site.facebook, icon: 'facebook' },
  { label: 'Tripadvisor', handle: c.footer.reviews, href: site.tripadvisor, icon: 'tripadvisor' },
];
---

<ul class:list={['social__list', className]} style={`--social-cols: ${columns}`}>
  {
    socials.map((s) => (
      <li>
        <a class="social__link" href={s.href} target="_blank" rel="noopener">
          <span class="social__icon" aria-hidden="true">
            {s.icon === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {s.icon === 'tiktok' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M16.5 3h-2.8v12.1a2.5 2.5 0 1 1-2.1-2.5v-2.8a5.3 5.3 0 1 0 4.9 5.3V9.4a6.6 6.6 0 0 0 3.7 1.2V7.8a3.8 3.8 0 0 1-3.7-3.8V3z" />
              </svg>
            )}
            {s.icon === 'facebook' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2v2h-2.6v3h2.6V21h3.3z" />
              </svg>
            )}
            {s.icon === 'tripadvisor' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="7.4" cy="13" r="4" />
                <circle cx="16.6" cy="13" r="4" />
                <circle cx="7.4" cy="13" r="1.3" fill="currentColor" stroke="none" />
                <circle cx="16.6" cy="13" r="1.3" fill="currentColor" stroke="none" />
                <path d="M8.6 7.4a9.6 9.6 0 0 1 6.8 0" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <span class="social__text">
            <span class="social__name">{s.label}</span>
            <span class="social__handle">{s.handle}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social__list {
    display: grid;
    grid-template-columns: repeat(var(--social-cols, 4), minmax(0, 1fr));
    gap: var(--col-gap);
  }
  .social__link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition:
      border-color var(--dur-standard) var(--ease-out),
      background-color var(--dur-standard) var(--ease-out),
      transform var(--dur-standard) var(--ease-out);
  }
  .social__link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
  .social__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: border-color var(--dur-standard) var(--ease-out), color var(--dur-standard) var(--ease-out);
  }
  .social__link:hover .social__icon {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .social__icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .social__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .social__name {
    font-weight: 700;
    font-size: 0.92rem;
  }
  .social__handle {
    font-size: var(--text-small);
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 900px) {
    .social__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
  }
  @media (max-width: 460px) {
    .social__list {
      grid-template-columns: 1fr;
    }
  }
</style>
