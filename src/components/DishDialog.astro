---
/**
 * One dialog, reused by every row on the menu. The rows carry the data; this
 * is the vessel. Native <dialog> so focus, Escape and inertness come free.
 */
import { site } from '@/data/site';
---

<dialog class="dish" data-dish-dialog aria-labelledby="dish-name">
  <article class="dish__inner">
    <button type="button" class="dish__close" data-dish-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <figure class="dish__media" data-dish-media>
      <img data-dish-img alt="" decoding="async" />
      <span class="dish__plate" data-dish-plate aria-hidden="true">
        <img class="dish__plate-thumb" data-dish-thumb alt="" decoding="async" hidden />
        <span class="dish__plate-mark">Crush</span>
        <span class="dish__plate-strap">Food · Drinks · Beats</span>
      </span>
    </figure>

    <div class="dish__body">
      <p class="label muted dish__kicker" data-dish-kicker></p>

      <header class="dish__head">
        <h2 class="dish__name" id="dish-name" data-dish-name></h2>
        <p class="num dish__price" data-dish-price></p>
      </header>

      <p class="dish__desc" data-dish-desc></p>

      <ul class="dish__tags" data-dish-tags></ul>

      <div class="dish__note" data-dish-note hidden>
        <p class="dish__note-text" data-dish-note-text></p>
        <blockquote class="dish__quote" data-dish-quote hidden>
          <p data-dish-quote-text></p>
          <footer class="label muted" data-dish-quote-by></footer>
        </blockquote>
      </div>

      <footer class="dish__foot">
        <p class="small muted">
          Allergens and dietary options: ask the team. Alternative milks, gluten-free bread and vegan options
          run across the menu.
        </p>
        <div class="dish__actions">
          <a href={site.maps} target="_blank" rel="noopener" class="btn btn--sm">Find us</a>
          <button type="button" class="btn btn--sm btn--ghost" data-dish-close>Back to the menu</button>
        </div>
      </footer>
    </div>
  </article>
</dialog>

<style>
  .dish {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(1040px, calc(100vw - 2 * var(--gutter)));
    max-height: min(88svh, 760px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-0);
    background: var(--canvas);
    color: var(--ink);
    overflow: hidden;
    opacity: 0;
    transform: translateY(18px) scale(0.985);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.55s var(--ease-out),
      overlay 0.55s allow-discrete,
      display 0.55s allow-discrete;
  }
  .dish[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .dish[open] {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }
  }
  .dish::backdrop {
    background: rgba(11, 9, 14, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition:
      opacity 0.4s var(--ease-out),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }
  .dish[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .dish[open]::backdrop {
      opacity: 0;
    }
  }

  .dish__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    max-height: inherit;
  }

  /* ---- media ---- */
  .dish__media {
    position: relative;
    background: var(--canvas-2);
    overflow: hidden;
    min-height: 100%;
  }
  .dish__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dish__media.is-empty > img {
    display: none;
  }
  /* No photo? A typographic plate instead of a hole. */
  .dish__plate {
    position: absolute;
    inset: 0;
    display: none;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    background:
      radial-gradient(120% 90% at 50% 0%, var(--canvas) 0%, var(--canvas-2) 60%, var(--canvas-3) 100%);
    text-align: center;
    padding: var(--space-6);
  }
  .dish__media.is-empty .dish__plate {
    display: grid;
  }
  /* The venue's own 160px menu shot, shown at a size it can actually hold */
  .dish__plate-thumb {
    /* A definite width: a percentage against an auto-sized centred grid track
       resolves to zero. */
    width: 190px;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--canvas);
    box-shadow: 0 8px 30px rgba(20, 18, 26, 0.16);
    margin-bottom: var(--space-3);
  }
  .dish__plate-thumb[hidden] {
    display: none;
  }
  .dish__media.has-thumb .dish__plate-mark {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
  }
  .dish__media.has-thumb .dish__plate-strap {
    font-size: 0.62rem;
  }
  .dish__plate-mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .dish__plate-strap {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---- body ---- */
  .dish__body {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6) var(--space-6);
    overflow-y: auto;
  }
  .dish__kicker {
    color: var(--accent-ink);
  }
  .dish__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line-strong);
  }
  .dish__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .dish__price {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .dish__desc {
    font-size: var(--text-lede);
    line-height: 1.45;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .dish__desc:empty {
    display: none;
  }
  .dish__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .dish__tags :global(li) {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .dish__tags :global(li:first-child) {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .dish__note[hidden],
  .dish__quote[hidden] {
    display: none;
  }
  .dish__note {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .dish__note-text {
    max-width: 52ch;
    text-wrap: pretty;
  }
  .dish__quote {
    display: grid;
    gap: 0.4rem;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
  }
  .dish__quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.15;
  }
  .dish__foot {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
    margin-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .dish__foot p {
    max-width: 52ch;
  }
  .dish__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .dish__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--canvas);
    color: var(--ink);
    box-shadow: 0 2px 14px rgba(20, 18, 26, 0.18);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast);
  }
  .dish__close svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .dish__close:hover {
    transform: rotate(90deg);
    background: var(--ink);
    color: var(--canvas);
  }

  @media (max-width: 860px) {
    .dish {
      width: 100vw;
      max-width: 100vw;
      max-height: 92svh;
      margin: auto 0 0;
      inset: 0;
    }
    .dish__inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      overflow-y: auto;
    }
    .dish__media {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
    .dish__body {
      padding: var(--space-5) var(--gutter) var(--space-6);
      overflow: visible;
    }
    .dish__plate-thumb {
      width: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dish,
    .dish::backdrop {
      transition: none;
    }
    .dish[open] {
      transform: none;
    }
  }
</style>
